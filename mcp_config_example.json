{
  "mcpServers": {
    "disk-kg-local": {
      "command": "uv",
      "args": [
        "--directory",
        "/PATH/TO/DISK",
        "run",
        "--no-dev",
        "disk-mcp"
      ],
      "env": {
        "DISK_CONFIG_PATH": "C:/Users/wujun/Desktop/DISK/config.toml"
      }
    },
    "disk-kg-uvx": {
      "command": "uvx",
      "args": ["--from", "disk-kg", "disk-mcp"],
      "env": {
        "DISK_CONFIG_PATH": "/path/to/your/config.toml"
      }
    }
  }
}
